# Lurni Academy Cloud — environment configuration example.
# Copy to ".env" and fill in YOUR OWN values. Never commit a real .env file.

APP_NAME="Lurni Academy Cloud"
APP_ENV=production
APP_DEBUG=false
APP_URL=https://your-domain.example

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=lurni_academy_cloud
DB_USER=your_db_user
DB_PASS=your_db_password_here

MAIL_FROM=no-reply@your-domain.example

# Payment provider (optional — leave empty to use manual payment recording only)
PAYMENT_PROVIDER=
PAYMENT_PUBLIC_KEY=
PAYMENT_SECRET_KEY=
